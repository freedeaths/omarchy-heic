#!/usr/bin/env python3
"""Private timewall setter: acknowledge only; never change the desktop."""
import json
import os
from pathlib import Path
import sys
import tempfile

result = Path(sys.argv[1])
image = str(Path(sys.argv[2]).resolve(strict=True))
fd, tmp = tempfile.mkstemp(dir=result.parent)
with os.fdopen(fd, 'w') as f:
    json.dump({'image': image}, f)
    f.flush()
    os.fsync(f.fileno())
os.replace(tmp, result)
