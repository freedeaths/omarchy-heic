#!/usr/bin/env python3
"""Isolated local GTK file chooser; stdout is a JSON array, including on cancel."""
import argparse
import json
import os
from pathlib import Path
import sys


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--title', required=True)
    parser.add_argument('--filter', required=True)
    parser.add_argument('--accept', required=True)
    parser.add_argument('--cancel', required=True)
    parser.add_argument('--hint', required=True)
    parser.add_argument('--folder', type=Path)
    args = parser.parse_args()
    # No remote files are supported. Avoid loading GVfs modules into the picker.
    os.environ['GIO_USE_VFS'] = 'local'
    import gi
    gi.require_version('Gtk', '3.0')
    from gi.repository import Gtk

    dialog = Gtk.FileChooserDialog(title=args.title, action=Gtk.FileChooserAction.OPEN)
    dialog.add_buttons(args.cancel, Gtk.ResponseType.CANCEL, args.accept, Gtk.ResponseType.ACCEPT)
    dialog.set_select_multiple(True)
    dialog.set_local_only(True)
    dialog.set_default_size(800, 560)
    dialog.set_default_response(Gtk.ResponseType.ACCEPT)
    folder = args.folder or Path.home() / 'Downloads'
    dialog.set_current_folder(str(folder if folder.is_dir() else Path.home()))
    file_filter = Gtk.FileFilter()
    file_filter.set_name(args.filter)
    file_filter.add_custom(Gtk.FileFilterFlags.FILENAME,
                           lambda info, _: Path(info.filename).suffix.lower() in ('.heic', '.heif'), None)
    dialog.add_filter(file_filter)
    hint = Gtk.Label(label=args.hint)
    hint.set_line_wrap(True)
    dialog.set_extra_widget(hint)
    hint.show()
    try:
        response = dialog.run()
        paths = dialog.get_filenames() if response == Gtk.ResponseType.ACCEPT else []
        # Validate again in case a path was typed instead of chosen from the list.
        paths = [p for p in paths if Path(p).is_file() and Path(p).suffix.lower() in ('.heic', '.heif')]
        print(json.dumps(paths, ensure_ascii=False), flush=True)
    finally:
        dialog.destroy()


if __name__ == '__main__':
    try:
        main()
    except Exception as exc:
        print(str(exc), file=sys.stderr)
        sys.exit(1)
